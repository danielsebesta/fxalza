BRIGHTDATA_KEY=
BRIGHTDATA_ZONE=web_unlocker1
SCRAPEDO_TOKEN=
FIRECRAWL_KEY=
# Prohlížeč v cloudu jako poslední záchrana, když Cloudflare odmítne ostatní (relace se drží otevřená a po 2 min nečinnosti zavře)
BROWSERBASE_API_KEY=
# Vlastní Cloudflare Workery (worker/), které se ptají Alzy z Cloudflare; zdarma, hned za sidecarem. Tvar url|token, oddělené čárkou, první je primární
# Adresy držet jen tady a na serveru, do gitu nepatří
CF_WORKERS=

# Provoz (hodnoty jsou výchozí, měň jen když víš proč)
# HOST=0.0.0.0
# PORT=8484
# Obchod Alzy s vlastni domenou misto subdomeny (sk.fxalza.cz zustane funkcni): SHOP_DOMAINS=sk=fxalza.sk,hu=fxalza.hu
# SHOP_DOMAINS=
# TIERS_LEAN=1
# SIDECAR_WORKERS=3
# SIDECAR_MAX_QUEUE=200
# RATE_GLOBAL_PER_MIN=45
# RATE_DISCORD_PER_MIN=30
# RATE_OTHER_GLOBAL_PER_MIN=6
# RATE_OTHER_PER_10MIN=3
# DISCORD_IPS_STRICT=1
# PAID_DAILY_MAX=300
# EMBED_DEADLINE_MS=5000
# PAGE_DEADLINE_MS=12000
# SHUTDOWN_GRACE_MS=8000
# SIDECAR_RESTART_AFTER_TIMEOUTS=3
# CACHE_FILE=data/cache.json
# IP_RANGES_REFRESH=1
# SIDECAR_ALLOWED_HOSTS=alza.cz,alza.sk,alza.hu,alza.de,alza.at
# SIDECAR_MAX_BODY_BYTES=8388608
# FETCH_MAX_BODY_BYTES=8388608
# TRUSTED_PROXIES=127.0.0.1,::1
